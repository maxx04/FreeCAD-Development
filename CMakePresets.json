{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "FCProject-Dev",
            "displayName": "Build gegen die FreeCAD-Sandbox (Header/Bibliotheken)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build-fc263",
            "cacheVariables": {
                "CMAKE_PRES_DEV": "TRUE",
                "CMAKE_BUILD_TYPE": "Debug",
                "PYTHON_EXECUTABLE": "${sourceDir}/../.venv/bin/python",
                "CMAKE_CURRENT_SOURCE_DIR": "${sourceDir}/FCProject",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "FC_SOURCE_DIR": "/home/maxx/freecad-sandbox/freecad-source",
                "FC_LIB_DIR": "/home/maxx/freecad-sandbox/install/lib"
            }
        }
    ]
}
