{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "FC-1.2dev",
            "displayName": "FreeCAD 1.2 (Python 3.12)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build-fc12",
            "cacheVariables": {
                "CMAKE_PRES_12": "TRUE",
                "CMAKE_PRES_11": "FALSE",
                "CMAKE_BUILD_TYPE": "Debug",
                "PYTHON_EXECUTABLE": "${sourceDir}/../.venv/bin/python",
                "CMAKE_CURRENT_SOURCE_DIR": "${sourceDir}/FCProject"
            }
        },
        {
            "name": "FC-1.1.1",
            "displayName": "FreeCAD 1.1.1 (Python 3.11)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build-fc11",
            "cacheVariables": {
                "CMAKE_PRES_12": "FALSE",
                "CMAKE_PRES_11": "TRUE",
                "CMAKE_BUILD_TYPE": "Debug",
                "PYTHON_EXECUTABLE": "${sourceDir}/../.venv311/bin/python",
                "CMAKE_CURRENT_SOURCE_DIR": "${sourceDir}/FCProject"
            }
        }
    ]
}
