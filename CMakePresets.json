{
    "version": 3,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "FCProject-Dev",
            "displayName": "FreeCAD Dev (Python 3.12, selbst gebaut, isoliertes Profil)",
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build-fc263",
            "cacheVariables": {
                "CMAKE_PRES_DEV": "TRUE",
                "CMAKE_BUILD_TYPE": "Debug",
                "PYTHON_EXECUTABLE": "${sourceDir}/../.venv/bin/python",
                "CMAKE_CURRENT_SOURCE_DIR": "${sourceDir}/FCProject",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "FC_SOURCE_DIR": "/home/maxx/freecad/freecad-source",
                "FC_LIB_DIR": "/home/maxx/freecad/install/lib",
                "FC_MOD_DIR": "/home/maxx/freecad/freecad-dev-profile/Mod/FCProject"
            }
        }
    ]
}
