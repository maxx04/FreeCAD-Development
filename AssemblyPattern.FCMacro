import FreeCAD as App
import FreeCADGui as Gui

def convert_array_to_bom_group():
    doc = App.ActiveDocument
    selection = Gui.Selection.getSelection()
    
    if len(selection) != 1:
        App.Console.PrintError("Bitte das Draft-Array auswählen.\n")
        return

    array_obj = selection[0]
    base_obj = array_obj.Base
    
    # 1. Parent Assembly finden
    parent_asm = None
    for p in base_obj.InList:
        if p.isDerivedFrom("App::Part"):
            parent_asm = p
            break
            
    if not parent_asm:
        App.Console.PrintError("Keine Assembly gefunden.\n")
        return

    # 2. Eine Gruppe für die Ordnung und die BOM erstellen
    group_name = f"Gruppe_{base_obj.Label}"
    pattern_group = doc.getObject(group_name)
    if not pattern_group:
        pattern_group = doc.addObject("App::DocumentObjectGroup", group_name)
        pattern_group.Label = f"Muster {base_obj.Label}"
        # Die Gruppe in die Assembly einsortieren
        parent_asm.addObject(pattern_group)

    # 3. Placements holen (mit unserem Force-Expand-Trick von vorhin)
    array_obj.ExpandArray = True
    doc.recompute()
    placements = array_obj.Proxy.getPlacements(array_obj)

    # 4. Links erstellen und in die Gruppe schieben
    doc.openTransaction("BOM Grouping")
    
    m_asm_inv = parent_asm.getGlobalPlacement().inverse().toMatrix()
    m_array_global = array_obj.getGlobalPlacement().toMatrix()

    for i, p in enumerate(placements):
        link_name = f"Lnk_{base_obj.Name}_{i:02d}"
        new_link = doc.addObject("App::Link", link_name)
        new_link.setLink(base_obj)
        new_link.Label = base_obj.Label # Gleiches Label für korrekte Zählung
        
        # Matrix-Berechnung
        m_copy_world = m_array_global.multiply(p.toMatrix())
        new_link.Placement = App.Placement(m_asm_inv.multiply(m_copy_world))
        
        # Link in die Gruppe schieben
        pattern_group.addObject(new_link)

    # 5. DAS WICHTIGSTE FÜR DIE KAUFMENGE:
    # Wir blenden das Array aus.
    array_obj.Visibility = False
    # Das Original-Teil sollte NICHT in der gleichen Gruppe wie die Links liegen,
    # damit die BOM es nicht als 5. Teil zählt, wenn "detail Parts" an ist.
    
    doc.commitTransaction()
    doc.recompute()
    App.Console.PrintMessage(f"ERFOLG: {len(placements)} Balken in Gruppe '{group_name}' erstellt.\n")

convert_array_to_bom_group()
