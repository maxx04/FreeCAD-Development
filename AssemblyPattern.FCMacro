import FreeCAD as App
import FreeCADGui as Gui

def convert_array_to_links():
    doc = App.ActiveDocument
    if not doc: return

    App.Console.PrintMessage("\n" + ">"*10 + " Array-to-Links Conversion " + "<"*10 + "\n")
    
    selection = Gui.Selection.getSelection()
    if len(selection) != 1:
        App.Console.PrintError("Bitte ein Draft-Array auswählen.\n")
        return

    array_obj = selection[0]
    if not hasattr(array_obj, "Base") or array_obj.Base is None:
        return

    base_obj = array_obj.Base
    
    # 1. Parent Assembly finden (wie gehabt)
    parent_assembly = None
    for p in base_obj.InList:
        if p.isDerivedFrom("App::Part"):
            parent_assembly = p
            break

    if not parent_assembly:
        App.Console.PrintError("Basis-Teil ist in keiner Assembly.\n")
        return

    # 2. Positionen aus dem Array extrahieren (ROBUSTERER WEG)
    placements = []
    
    # Weg A: Direkt über das Objekt (falls verfügbar)
    if hasattr(array_obj, "getPlacements"):
        placements = array_obj.getPlacements()
    
    # Weg B: Über das Proxy-Objekt (Häufig bei Draft-Arrays)
    elif hasattr(array_obj, "Proxy") and hasattr(array_obj.Proxy, "getPlacements"):
        placements = array_obj.Proxy.getPlacements(array_obj)
    
    # Weg C: Manuelle Berechnung (Falls A und B scheitern)
    else:
        # Wir versuchen die Platzierungen aus dem Shape-Compound zu ziehen
        if hasattr(array_obj, "Shape") and array_obj.Shape.Compounds:
            placements = [c.Placement for c in array_obj.Shape.Compounds]

    if not placements:
        App.Console.PrintError("FEHLER: Konnte keine Positionen im Array finden.\n")
        return

    App.Console.PrintMessage(f"DEBUG: {len(placements)} Positionen gefunden.\n")


    App.Console.PrintMessage(f"Erstelle {len(placements)} Links für {base_obj.Label}...\n")

    # 3. Links erstellen und einsortieren
    doc.openTransaction("Convert Array to Links")
    
    # Wir brauchen die Matrix der Assembly für die globale Korrektur
    m_asm_inv = parent_assembly.getGlobalPlacement().inverse().toMatrix()
    m_array_global = array_obj.getGlobalPlacement().toMatrix()

    for i, p in enumerate(placements):
        # Name und Label wie das Originalteil + Index
        link_name = f"Lnk_{base_obj.Name}_{i:02d}"
        new_link = doc.addObject("App::Link", link_name)
        new_link.setLink(base_obj)
        
        # Jedes Teil bekommt das Label des Basis-Objekts (WICHTIG FÜR BOM)
        new_link.Label = base_obj.Label 
        
        # Position berechnen: Array-Welt-Position * Relative Kopie-Position
        # Dann umrechnen in die lokale Assembly-Welt
        m_copy_local_to_array = p.toMatrix()
        m_copy_world = m_array_global.multiply(m_copy_local_to_array)
        m_final_local = m_asm_inv.multiply(m_copy_world)
        
        new_link.Placement = App.Placement(m_final_local)
        
        # Link in die Assembly schieben
        parent_assembly.addObject(new_link)

    # 4. Das alte Array "entsorgen"
    # Wir löschen es nicht direkt, sondern verstecken es und nehmen es aus der BOM
    array_obj.Visibility = False
    
    doc.commitTransaction()
    doc.recompute()
    App.Console.PrintMessage("ERFOLG: Array durch Links ersetzt. BOM sollte nun stimmen!\n")

# Start
convert_array_to_links()
