import FreeCAD as App
import FreeCADGui as Gui

def select_parent_assembly():
    App.Console.PrintMessage("\n" + ">"*10 + " Suche Parent Assembly " + "<"*10 + "\n")
    
    # 1. Prüfung: Nur genau EINE Selektion erlauben
    selection = Gui.Selection.getSelection()
    if len(selection) != 1:
        App.Console.PrintError("ABBRUCH: Bitte wähle genau EIN Teil aus!\n")
        return

    selected_obj = selection[0]
    
    # 2. Den direkten Parent (Vater-Objekt) finden
    parent_assembly = None
    
    if selected_obj.InList:
        for p in selected_obj.InList:
            # Prüfung: Ist der Parent eine Assembly? 
            # In FreeCAD 1.1 erkennt man sie am Typ 'App::Part' 
            # (oft mit dem Attribut 'AssemblyType', aber 'App::Part' ist die Basis)
            if p.isDerivedFrom("App::Part"):
                parent_assembly = p
                break

    # 3. Finale Prüfung und Selektion
    if parent_assembly:
        App.Console.PrintMessage(f"Erfolg: '{selected_obj.Label}' gehört zu Assembly '{parent_assembly.Label}'\n")
        
        # Visuelle Selektion im Baum ändern
        Gui.Selection.clearSelection()
        Gui.Selection.addSelection(parent_assembly)
    else:
        App.Console.PrintMessage(f"Info: '{selected_obj.Label}' hat keine übergeordnete Assembly.\n")

# Start
select_parent_assembly()
