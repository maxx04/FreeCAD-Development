import FreeCAD as App
import FreeCADGui as Gui

def convert_array_to_bom_group():
    doc = App.ActiveDocument
    selection = Gui.Selection.getSelection()
    
    if len(selection) != 1:
        App.Console.PrintError("Bitte das Draft-Array auswählen.\n")
        return

    array_obj = selection[0]
    base_obj = array_obj.Base
    
    # 1. Parent Assembly finden
    parent_asm = None
    for p in base_obj.InList:
        if p.isDerivedFrom("App::Part"):
            parent_asm = p
            break
            
    if not parent_asm:
        App.Console.PrintError("Keine Assembly gefunden.\n")
        return

    # 2. Expansion erzwingen (Das ist der Schlüssel!)
    array_obj.ExpandArray = True
    doc.recompute()

    # 3. Positionen auslesen - ROBUSTER WEG
    placements = []
    # Wir schauen in die 'OutList'. Wenn ExpandArray an ist, liegen dort die Kopien als Objekte.
    sub_elements = [o for o in array_obj.OutList if hasattr(o, "Placement")]
    
    if sub_elements:
        placements = [el.Placement for el in sub_elements]
    elif hasattr(array_obj, "Proxy") and hasattr(array_obj.Proxy, "getPlacements"):
        # Zweiter Versuch über den Proxy
        placements = array_obj.Proxy.getPlacements(array_obj)
    else:
        # Letzter Versuch über den Geometrie-Compound
        placements = [c.Placement for c in array_obj.Shape.Compounds]

    if not placements:
        App.Console.PrintError("FEHLER: Konnte keine Positionen extrahieren.\n")
        return

    # 4. Gruppe erstellen
    group_name = f"Muster_Links_{base_obj.Label}"
    pattern_group = doc.getObject(group_name)
    if not pattern_group:
        pattern_group = doc.addObject("App::DocumentObjectGroup", group_name)
        pattern_group.Label = f"Kaufteile {base_obj.Label}"
        parent_asm.addObject(pattern_group)

    # 5. Links erstellen
    doc.openTransaction("BOM Clean Grouping")
    m_asm_inv = parent_asm.getGlobalPlacement().inverse().toMatrix()
    m_array_global = array_obj.getGlobalPlacement().toMatrix()

    for i, p in enumerate(placements):
        link_name = f"Lnk_{base_obj.Name}_{i:02d}"
        
        # Falls der Link schon existiert, löschen wir ihn (für Updates)
        old_lnk = doc.getObject(link_name)
        if old_lnk: doc.removeObject(old_lnk.Name)
            
        new_link = doc.addObject("App::Link", link_name)
        new_link.setLink(base_obj)
        new_link.Label = base_obj.Label
        
        m_copy_world = m_array_global.multiply(p.toMatrix())
        new_link.Placement = App.Placement(m_asm_inv.multiply(m_copy_world))
        
        pattern_group.addObject(new_link)

    # 6. Original-Array "stumm" schalten
    array_obj.Visibility = False
    
    doc.commitTransaction()
    doc.recompute()
    App.Console.PrintMessage(f"ERFOLG: {len(placements)} Balken in '{pattern_group.Label}' einsortiert.\n")

convert_array_to_bom_group()
