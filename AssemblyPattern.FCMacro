import FreeCAD as App
import FreeCADGui as Gui

def move_array_to_part_assembly():
    doc = App.ActiveDocument

    App.Console.PrintMessage("\n" + ">"*10 + " Array-to-Parent-Assembly " + "<"*10 + "\n")
    
        # 1. Prüfung: Nur ein Objekt auswählen (das Array)
    selection = Gui.Selection.getSelection()
    if len(selection) != 1:
        App.Console.PrintError("Bitte wähle genau EIN Draft-Array aus.\n")
        return

    # KORREKTUR: Das erste Element aus der Liste nehmen
    array_obj = selection[0]
    
    # Jetzt funktioniert .Label, da array_obj kein 'list' mehr ist
    if not hasattr(array_obj, "Base") or array_obj.Base is None:
        App.Console.PrintError(f"Das Objekt '{array_obj.Label}' ist kein Muster oder hat keine Basis.\n")
        return


    base_obj = array_obj.Base
    App.Console.PrintMessage(f"Basis-Teil identifiziert: {base_obj.Label}\n")

    # 2. Die Assembly des Basis-Teils suchen (Nach oben wandern)
    parent_assembly = None
    if base_obj.InList:
        for p in base_obj.InList:
            if p.isDerivedFrom("App::Part"):
                parent_assembly = p
                break

    if not parent_assembly:
        App.Console.PrintMessage(f"Basis '{base_obj.Label}' liegt in keiner Unterbaugruppe.\n")
        return

    # 3. Das Array in diese Assembly verschieben
        # Sicherstellen, dass wir das Dokument greifen
    doc = App.ActiveDocument
    
    if not doc:
        App.Console.PrintError("FEHLER: Kein aktives Dokument gefunden!\n")
        return

    # 3. Das Array in diese Assembly verschieben
    if array_obj in parent_assembly.Group:
        App.Console.PrintMessage(f"Array '{array_obj.Label}' ist bereits in '{parent_assembly.Label}'.\n")
            # ...
    else:
        # 1. Die globale Position (Welt-Koordinate) VOR dem Verschieben merken
        global_placement = array_obj.getGlobalPlacement()
        
        # 2. Verschieben
        parent_assembly.addObject(array_obj)
        
        # 3. KORREKTUR: Die Position im neuen Container so anpassen, 
        # dass die Welt-Koordinate gleich bleibt (Matrix-Mathematik)
        # Formel: (Parent-Invers) * Welt-Position
        parent_m_inv = parent_assembly.getGlobalPlacement().inverse().toMatrix()
        local_m = parent_m_inv.multiply(global_placement.toMatrix())
        array_obj.Placement = App.Placement(local_m)

        # 4. Den "Still Touched" Loop unterbrechen
        array_obj.purgeTouched()
        doc.recompute()
        
        # 5. Ein zweiter Recompute NUR für die Assembly
        parent_assembly.recompute()
        
        App.Console.PrintMessage(f"ERFOLG: '{array_obj.Label}' verschoben und stabilisiert.\n")



# Start
move_array_to_part_assembly()
