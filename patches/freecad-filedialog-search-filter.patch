+/*!
+ * Proxy model used by FileDialog's live search field (see
+ * FileDialog::setupSearchFilter()). Behaves like a plain name filter
+ * (QSortFilterProxyModel::setFilterRegularExpression()/filterAcceptsRow()),
+ * except that directories are always accepted regardless of the current
+ * pattern, so the user can keep navigating into folders while a filter is
+ * active instead of the whole tree collapsing to nothing.
+ */
+class FileDialogSearchProxyModel: public QSortFilterProxyModel
+{
+public:
+    using QSortFilterProxyModel::QSortFilterProxyModel;
+
+protected:
+    bool filterAcceptsRow(int sourceRow, const QModelIndex& sourceParent) const override
+    {
+        if (auto* fsModel = qobject_cast<QFileSystemModel*>(sourceModel())) {
+            QModelIndex index = fsModel->index(sourceRow, 0, sourceParent);
+            if (fsModel->isDir(index)) {
+                return true;
+            }
+        }
+        return QSortFilterProxyModel::filterAcceptsRow(sourceRow, sourceParent);
+    }
+};
 }  // namespace
 
