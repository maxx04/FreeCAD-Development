{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: build FCProjectCpp",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build --target FCProjectCpp",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Build FCProjectCpp",
            "type": "shell",
            "command": "mkdir -p build && cd build && cmake -DCMAKE_INSTALL_PREFIX=/home/maxx/freecad/freecad-source/bin -DFreeCAD_DIR=/home/maxx/freecad/freecad-source/cmake .. && make -j$(nproc) && make install",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": true
            }
        }
    ]

}