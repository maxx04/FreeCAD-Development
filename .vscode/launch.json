{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch FreeCAD",
            "type": "cppdbg",
            "request": "launch",
            "program": "/home/maxx/freecad/freecad-source/bin/FreeCAD",
            "args": ["-l"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                { "name": "LD_LIBRARY_PATH", "value": "/home/maxx/Documents/FreeCAD-Development/.venv/lib/python3.12/site-packages/PySide6/Qt/lib:/lib/x86_64-linux-gnu" },
                { "name": "PYTHONPATH", "value": "/home/maxx/Documents/FreeCAD-Development/.venv/lib/python3.12/site-packages" },
                { "name": "PYTHONNOUSERSITE", "value": "1" },
                { "name": "QT_PLUGIN_PATH", "value": "/home/maxx/Documents/FreeCAD-Development/.venv/lib/python3.12/site-packages/PySide6/Qt/plugins" }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Ignoriere SIGPWR und SIGXCPU (beschleunigt Python-Debugging)",
                    "text": "handle SIGPWR SIGXCPU nostop noprint pass",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: FreeCAD Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${workspaceFolder}"
                }
            ]
        }
    ],
    "compounds": [
        {
            "name": "FreeCAD Komplett-Debug (C++ & Python)",
            "configurations": ["(gdb) Launch FreeCAD", "Python: FreeCAD Attach"]
        }
    ]
}
