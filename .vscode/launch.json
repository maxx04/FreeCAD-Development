{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) Launch FreeCAD 26.3dev",
            "type": "cppdbg",
            "request": "launch",
            "program": "/bin/bash",
            "args": ["/home/maxx/freecad/run-freecad-26.3.sh"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Nach exec() im Startskript (bash -> FreeCAD) weiter debuggen, statt abzubrechen",
                    "text": "set follow-exec-mode same",
                    "ignoreFailures": true
                },
                {
                    "description": "Ignoriere SIGPWR und SIGXCPU (beschleunigt Python-Debugging)",
                    "text": "handle SIGPWR SIGXCPU nostop noprint pass",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: FreeCAD Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "${workspaceFolder}"
                }
            ]
    
        },
        {
            "name": "(gdb) Attach to FreeCAD",
            "type": "cppdbg",
            "request": "attach",
            "program": "/home/maxx/freecad/install/bin/FreeCAD",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Ignoriere Signale",
                    "text": "handle SIGPWR SIGXCPU nostop noprint pass",
                    "ignoreFailures": true
                }
        ]
        }

    ],
    "compounds": [
        {
            "name": "FreeCAD 26.3 Komplett-Debug (C++ & Python)",
            "configurations": ["(gdb) Launch FreeCAD 26.3dev", "Python: FreeCAD Attach"]
        }
    ]
}
